            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "59fd74c9-8a43-4dd4-ad77-8e3eccc62038",
              "name": "Timeseries data points",
              "originalRequest": {
                "url": {
                  "path": [
